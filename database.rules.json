{
  "rules": {
    ".read": false,
    ".write": false,
    "swagbot1": {
      ".read": true,
      ".write": true,
      "current_location": {
        ".validate": "newData.isString() && (newData.val() === 'docking' || newData.val() === 'table1' || newData.val() === 'table2' || newData.val() === 'table3' || newData.val() === 'table4')"
      },
      "home": {
        ".validate": "newData.isBoolean()"
      },
      "move": {
        ".validate": "newData.isBoolean()"
      },
      "trip_status": {
        ".validate": "newData.isString() && (newData.val() === 'docking' || newData.val() === 'en_route' || newData.val() === 'arrived' || newData.val() === 'returning')"
      },
      "table1": {
        "arrived": {
          ".validate": "newData.isBoolean()"
        },
        "confirmed": {
          ".validate": "newData.isBoolean()"
        },
        "mission": {
          ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'destination')"
        },
        "status": {
          ".validate": "newData.isBoolean()"
        }
      },
      "table2": {
        "arrived": {
          ".validate": "newData.isBoolean()"
        },
        "confirmed": {
          ".validate": "newData.isBoolean()"
        },
        "mission": {
          ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'destination')"
        },
        "status": {
          ".validate": "newData.isBoolean()"
        }
      },
      "table3": {
        "arrived": {
          ".validate": "newData.isBoolean()"
        },
        "confirmed": {
          ".validate": "newData.isBoolean()"
        },
        "mission": {
          ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'destination')"
        },
        "status": {
          ".validate": "newData.isBoolean()"
        }
      },
      "table4": {
        "arrived": {
          ".validate": "newData.isBoolean()"
        },
        "confirmed": {
          ".validate": "newData.isBoolean()"
        },
        "mission": {
          ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'destination')"
        },
        "status": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}

